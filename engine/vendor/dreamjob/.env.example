# Telegram
TELEGRAM_BOT_TOKEN=replace_me
MVP_OWNER_TELEGRAM_ID=replace_with_numeric_id

# OpenAI-compatible LLM endpoint
OPENAI_API_KEY=replace_me
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=replace_with_model_id
OPENAI_LETTER_MODEL=
OPENAI_FALLBACK_MODEL=

# HH.ru OAuth (optional for the first Telegram-only launch)
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_USER_AGENT='DreamJobBot/1.0 (contact: you@example.com)'

# Candidate preferences; empty/zero values are neutral defaults
CANDIDATE_DATA_ROOT=
MIN_SALARY_RUB=0
CANDIDATE_HOME_TERMS=
BOT_TIMEZONE=UTC
HH_BROWSER_TIMEZONE=UTC
LOCAL_VARIANT_DB_PATH=var/candidate_mvp.sqlite3

# Safe defaults: no automatic writes to HH.ru
HH_APPLICATION_WRITES_ENABLED=0
AUTO_APPLY_ARMED=0
FOLLOWUP_ENABLED=0
FOLLOWUP_AUTO_SEND=0
RESUME_BUMP_ENABLED=0

# Optional background search
AUTO_SEARCH_INTERVAL_SECONDS=1200
AUTO_SEARCH_MAX_PER_CYCLE=3
HH_RECOMMENDATIONS_ENABLED=1
HH_RECOMMENDATIONS_INTERVAL_SECONDS=1800

# Optional Mini App; leave empty for polling-only mode
WEBAPP_PORT=
WEBAPP_HOST=127.0.0.1
WEBAPP_PUBLIC_URL=

# Optional Gonka route
GONKA_INTERNAL_ENABLED=false
GONKA_API_KEYS=

LOG_LEVEL=INFO
